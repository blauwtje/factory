{
  "name": "factory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "build": "vite build --config app/vite.config.ts",
    "tauri": "tauri",
    "lint": "eslint -c app/eslint.config.js app scripts",
    "typecheck": "tsc --noEmit -p app/tsconfig.json",
    "test": "vitest run --config app/vite.config.ts --passWithNoTests",
    "test:rust": "cargo test --manifest-path app/src-tauri/Cargo.toml",
    "licence": "node scripts/licence-check.mjs",
    "notices": "node scripts/notices.mjs",
    "release:check": "node scripts/release-check.mjs",
    "roles": "node kit/scripts/check-roles.mjs",
    "eval": "node kit/evals/run.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:rust && npm run licence && npm run roles"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@pierre/diffs": "^1.6.4",
    "@streamdown/code": "^2.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-resizable-panels": "^4.24.0",
    "recharts": "^3.11.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
