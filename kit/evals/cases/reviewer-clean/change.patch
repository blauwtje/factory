+++ b/src/clamp.mjs
@@ -0,0 +1,3 @@
+export function clamp(value, min, max) {
+  return Math.min(Math.max(value, min), max);
+}
diff --git a/test/clamp.test.mjs b/test/clamp.test.mjs
new file mode 100644
index 0000000..394ae16
--- /dev/null
+++ b/test/clamp.test.mjs
@@ -0,0 +1,17 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { clamp } from '../src/clamp.mjs';
+
+test('returns min below the range', () => {
+  assert.equal(clamp(-5, 0, 10), 0);
+});
+
+test('returns max above the range', () => {
+  assert.equal(clamp(15, 0, 10), 10);
+});
+
+test('returns the value inside the range and on its bounds', () => {
+  assert.equal(clamp(4, 0, 10), 4);
+  assert.equal(clamp(0, 0, 10), 0);
+  assert.equal(clamp(10, 0, 10), 10);
+});
