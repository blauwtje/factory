+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { paginate } from '../src/paginate.mjs';
+
+test('returns the items of a page', () => {
+  assert.deepEqual(paginate([1, 2, 3, 4], 1, 2), [1, 2]);
+  assert.deepEqual(paginate([1, 2, 3, 4], 2, 2), [3, 4]);
+});
+
+test('returns an empty array past the end', () => {
+  assert.deepEqual(paginate([1, 2, 3, 4], 3, 2), []);
+});
