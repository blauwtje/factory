@@ -0,0 +1,6 @@
+export function paginate(items, page, size) {
+  const pages = Math.floor(items.length / size);
+  if (page < 1 || page > pages) return [];
+  const start = (page - 1) * size;
+  return items.slice(start, start + size);
+}
