+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { shippingCents } from '../src/shipping.mjs';
+
+test('an order of exactly 5000 cents ships free', () => {
+  assert.equal(shippingCents(5000), 0);
+});
+
+test('an order of 4999 cents pays the flat rate', () => {
+  assert.equal(shippingCents(4999), 499);
+});
